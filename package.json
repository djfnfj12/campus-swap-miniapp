{
  "name": "campus-swap-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "校园闲置物品交易小程序 —— Web 仿小程序前端 + Node.js 后端 + SQLite 持久层",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js",
    "test:unit": "node --test tests/unit.test.js",
    "test:security": "node --test --test-concurrency=1 tests/security.test.js",
    "test:all": "node --test --test-concurrency=1 tests/unit.test.js tests/api.test.js tests/security.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT"
}
